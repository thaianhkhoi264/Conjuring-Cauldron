# Browser-safe Vapi public key and the ID of a saved Vapi assistant.
NEXT_PUBLIC_VAPI_PUBLIC_KEY=
VAPI_ASSISTANT_ID=

# Public HTTPS URL Vapi can reach (use a deployed URL or tunnel during local development).
NEXT_PUBLIC_APP_URL=

# Optional shared value configured as a custom header on the saved Vapi assistant.
VAPI_WEBHOOK_SECRET=
