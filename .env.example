# Browser-safe Vapi public key and the ID of a saved Vapi assistant.
NEXT_PUBLIC_VAPI_PUBLIC_KEY=
VAPI_ASSISTANT_ID=

# Public HTTPS URL Vapi can reach (use a deployed URL or tunnel during local development).
NEXT_PUBLIC_APP_URL=

# Optional shared value configured as a custom header on the saved Vapi assistant.
VAPI_WEBHOOK_SECRET=

# Copy to .env.local (gitignored). Never commit real keys.

# Gemini API key from Google AI Studio (fastest option)
GEMINI_API_KEY=

# Or use Vertex AI instead (set GOOGLE_GENAI_USE_VERTEXAI=true and run `gcloud auth application-default login`)
GOOGLE_GENAI_USE_VERTEXAI=false
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1

# Model IDs (check Google's docs for current names)
GEMINI_FAST_MODEL=
GEMINI_PRO_MODEL=

# Optional override for the SQLite file
# DATABASE_URL=.data/conjuring-cauldron.db
